# Copy to .env on the server and fill in. Never commit the result.
#
# Unlike deploy/compose/.env.example, most of this file IS secret. The compose
# file declares every one of these as `${VAR:?...}`, so a missing value stops
# the stack with a message naming the variable rather than starting it with a
# development default.
#
# Generate the secrets on the box, not on a laptop, and not into shell history:
#
#   umask 077 && touch .env          # so it is not world-readable from the start
#   openssl rand -base64 32          # for each of the three secrets below
#   openssl genrsa 2048 | base64 -w0 # for JWT_PRIVATE_KEY (drop -w0 on macOS)
#   make observer-key                # for OPSATLAS_OBSERVER_KEY

# -- Hostnames ---------------------------------------------------------------
# Three A records, all pointing at this box's IP. They must resolve before the
# first `docker compose up`: Caddy asks Let's Encrypt for certificates on start,
# and a name that does not resolve yet burns an attempt against a rate limit
# that allows five per hostname per week.
OPSATLAS_CONSOLE_HOST=opsatlas.example.com
OPSATLAS_API_HOST=api.opsatlas.example.com
OPSATLAS_AUTH_HOST=auth.opsatlas.example.com

# Where Let's Encrypt writes about expiring certificates. A real address you
# read; this is the only warning before a certificate lapses.
OPSATLAS_ACME_EMAIL=you@example.com

# -- Images ------------------------------------------------------------------
# What to run. A commit SHA or a release tag, never `latest`: a deployment you
# cannot name is a deployment you cannot roll back.
OPSATLAS_TAG=
# The identity provider, pinned for the same reason.
STORM_GATE_TAG=

# -- Secrets -----------------------------------------------------------------
OPSATLAS_DB_PASSWORD=
OPSATLAS_MONGO_USERNAME=opsatlas
OPSATLAS_MONGO_PASSWORD=

# Signs every token this deployment issues. Base64 of a PEM, because a PEM's
# newlines do not survive an env file. Generate a new one for this deployment -
# the local key from `make issuer-key` has been on a laptop and in a gitignored
# file, which is not where a production signing key should ever have been.
JWT_PRIVATE_KEY=
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# The observer's credential, from `make observer-key`. One value, set here once:
# the control plane reads it as OPSATLAS_OBSERVER_KEY and the observer as
# OPSATLAS_API_KEY, and the compose file wires the same variable to both.
OPSATLAS_OBSERVER_KEY=

# -- Bootstrap ---------------------------------------------------------------
# The first principal. Left empty on the very first start, because the subject
# is assigned by the issuer and the issuer is not running yet; fill it in from
# `make prod-first-user` and restart the control plane. Until it is set, the
# deployment authenticates people and then admits nobody, which is the intended
# failure rather than a broken one (ADR 0013).
OPSATLAS_BOOTSTRAP_SUBJECT=
OPSATLAS_BOOTSTRAP_DISPLAY_NAME=

# -- Optional ----------------------------------------------------------------
# A classic personal access token with `public_repo`, if this deployment should
# poll private or rate-limit-constrained sources. Unauthenticated polling is 60
# requests an hour per IP, which is roughly five sources at a five-minute
# interval - and on a shared host that budget is shared too.
OPSATLAS_GITHUB_TOKEN=

# The telemetry stack is not part of this compose file: four more containers on
# a 4GB box is most of the box. Point these at a collector if you run one.
OPSATLAS_TRACING_ENABLED=false
OPSATLAS_OTLP_ENDPOINT=

# The API is on the public internet here, so the explorer for it is off. Turn it
# on deliberately and briefly if you need it.
OPSATLAS_SWAGGER_UI=false
